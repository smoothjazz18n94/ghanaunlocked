# Copy to frontend/.env.local for local dev (never commit it).
# IMPORTANT: every VITE_* variable is bundled into public browser code.
# NEVER put secrets (bot token, DB URL, API keys) here.

# Base URL of the backend API, including /api/v1.
# Leave empty if the backend isn't deployed yet: the app still loads and
# shows a friendly "API not configured" state.
VITE_API_BASE_URL=http://localhost:8000/api/v1
