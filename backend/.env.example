# Copy to backend/.env  (never commit .env)

APP_NAME=Ghana Unlocked API
ENVIRONMENT=development        # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins.
# Add your Vercel URL here once you have it, e.g. https://ghana-unlocked.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional for the health check. Required only for migrations / DB features.
# Uses the psycopg v3 driver. A free Neon/Supabase/Render Postgres works too.
DATABASE_URL=postgresql+psycopg://ghana:ghana_dev_password@localhost:5432/ghana_unlocked

# Used server-side ONLY, to validate Telegram initData (future auth task).
# Same token the Telegram bot uses. Never put this in the frontend.
TELEGRAM_BOT_TOKEN=
